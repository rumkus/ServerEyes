DATABASE_URL=postgresql://usuario:password@host:puerto/database
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT (obligatorio). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Base de PRUEBAS para test-heartbeat.js y los tests de server/test (npm test).
# Nunca la de produccion: los tests crean y borran tablas. Sin esta variable
# los tests que necesitan base se saltan y test-heartbeat.js no arranca.
TEST_DATABASE_URL=postgresql://usuario:clave@localhost:5432/servereyes_test

# Proxies de confianza delante del servidor (saltos de X-Forwarded-For).
#   Railway: 1 (un edge que agrega la IP real al final de la cabecera).
#   Local / sin proxy: 0 -> la cabecera se ignora. NO usar 1 sin proxy: cualquier
#   cliente podria elegir su IP escribiendo la cabecera.
# Tambien acepta una lista de redes ("loopback, 10.0.0.0/8"). Ver SEGURIDAD-DESPLIEGUE.md.
TRUST_PROXY=0

# Pedidos de codigo de vinculacion permitidos por IP cada 10 minutos.
PAIRING_MAX_POR_IP=20
